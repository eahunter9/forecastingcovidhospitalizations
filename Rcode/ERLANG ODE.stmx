<?xml version="1.0" encoding="utf-8"?>
<xmile version="1.0" xmlns="http://docs.oasis-open.org/xmile/ns/XMILE/v1.0" xmlns:isee="http://iseesystems.com/XMILE">
	<header>
		<smile version="1.0" namespace="std, isee"/>
		<name>SEIR_delayed waning 3 compartment_realdata</name>
		<uuid>4ed8e36b-41a4-4e9a-9a07-31c345edc72b</uuid>
		<vendor>isee systems, inc.</vendor>
		<product version="3.7.3" isee:build_number="3465" isee:saved_by_v1="true" lang="en">Stella Architect</product>
	</header>
	<sim_specs isee:sim_duration="0" isee:run_prefix="Run" isee:simulation_delay="0" isee:restore_on_start="false" method="Euler" time_units="Months" isee:instantaneous_flows="false" isee:ignore_module_errors="false" isee:strict_units="true" isee:loop_scores="true" isee:loop_exhaustive_allowed="1000">
		<start>318</start>
		<stop>814</stop>
		<dt reciprocal="true">4</dt>
	</sim_specs>
	<isee:prefs saved_runs="5" keep="false" show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="false" layer="model" isee:design="Deluxe Prev-Next Blue Green Pastel" isee:design_custom="false" interface_scale_ui="true" interface_max_page_width="10000" interface_max_page_height="10000" interface_min_page_width="0" interface_min_page_height="0" rerun_on_structure_change="false" rifp="true"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" max_advance_time_in_ms="0" model_stops_when_players_drop="false" observer_start_page="home_page" enabled="false"/>
	<isee:time_formats default_format="Builtin">
		<isee:time_format name="Builtin" type="adaptive"/>
	</isee:time_formats>
	<isee:number_format_extenders/>
	<default_format/>
	<data>
		<export frequency="on_demand" resource="r../threedelaycompartment_100days.csv" precomputed="false" isee:format="numbers">
			<table name="Top-Level Table 1" use_settings="true"/>
		</export>
		<import isee:overwrite="false" orientation="horizontal" resource="r../COVIDweekly.csv"/>
	</data>
	<isee:sensi_specs_list active_index="0">
		<isee:sensi_specs name="Sensitivity" method="latin_hypercube" runs="100"/>
	</isee:sensi_specs_list>
	<isee:optimizer_specs_list active_index="0">
		<isee:optimizer_specs name="Optimization" method="Powell" use_additional_starts_file="false" additional_starts="500" report_interval="1" confidence_range="2">
			<isee:parameter name="Beta_parameter" min="0" max="20"/>
			<isee:parameter name="delay_duration" min="0" max="75"/>
			<isee:parameter name="HR" min="0" max="0.5"/>
			<isee:parameter name="initial_infected" min="0" max="0.25"/>
			<isee:parameter name="initial_recovered" min="0" max="0.25"/>
			<isee:payoff name="Payoff" action="min"/>
		</isee:optimizer_specs>
	</isee:optimizer_specs_list>
	<isee:payoff_specs_list>
		<isee:payoff_specs name="Payoff" calibration="true" recompute_weights="true">
			<isee:payoff_element name="measurement" weight="0.012438" compare_name="measurement" compare_run="Covidweekly_all" tolerance="0" type="ls"/>
		</isee:payoff_specs>
	</isee:payoff_specs_list>
	<model_units/>
	<model>
		<variables>
			<stock name="S">
				<eqn>pop  - initial_infected*pop - initial_recovered*pop-initial_exposed*pop</eqn>
				<inflow>WS</inflow>
				<outflow>SL</outflow>
				<non_negative/>
			</stock>
			<stock name="E">
				<eqn>initial_exposed*pop</eqn>
				<inflow>SL</inflow>
				<outflow>LI</outflow>
				<non_negative/>
			</stock>
			<stock name="I">
				<eqn>initial_infected*pop</eqn>
				<inflow>LI</inflow>
				<outflow>IR</outflow>
				<non_negative/>
			</stock>
			<stock name="R">
				<eqn>initial_recovered*pop</eqn>
				<inflow>IR</inflow>
				<outflow>RW</outflow>
				<non_negative/>
			</stock>
			<flow name="IR">
				<eqn>gamma_p*I</eqn>
				<non_negative/>
			</flow>
			<flow name="LI">
				<eqn>sigma_p*E</eqn>
				<non_negative/>
			</flow>
			<flow name="SL">
				<eqn>S*lambda</eqn>
				<non_negative/>
			</flow>
			<aux name="Beta parameter">
				<eqn>1.5</eqn>
			</aux>
			<aux name="sigma p">
				<eqn>0.5</eqn>
			</aux>
			<aux name="gamma p">
				<eqn>0.2</eqn>
			</aux>
			<aux name="lambda">
				<eqn>(Beta_parameter*I )/pop</eqn>
			</aux>
			<aux name="initial infected">
				<eqn>0.05</eqn>
			</aux>
			<aux name="pop">
				<eqn>5300000</eqn>
			</aux>
			<aux name="initial recovered">
				<eqn>0.05</eqn>
				<isee:delay_aux/>
			</aux>
			<stock name="Hospitalizations">
				<eqn>0</eqn>
				<inflow>measurement</inflow>
				<non_negative/>
			</stock>
			<aux name="HR">
				<eqn>0.1</eqn>
			</aux>
			<flow name="measurement">
				<eqn>HR*IR</eqn>
				<non_negative/>
			</flow>
			<flow name="RW">
				<eqn>R/(delay_duration/4)</eqn>
				<non_negative/>
			</flow>
			<aux name="waning">
				<eqn>0.9</eqn>
			</aux>
			<aux name="delay duration">
				<eqn>25</eqn>
			</aux>
			<stock name="W1">
				<eqn>0</eqn>
				<inflow>RW</inflow>
				<outflow>WW1</outflow>
				<non_negative/>
			</stock>
			<flow name="WW2">
				<eqn>W2/(delay_duration/4)</eqn>
				<non_negative/>
			</flow>
			<stock name="W2">
				<eqn>0</eqn>
				<inflow>WW1</inflow>
				<outflow>WW2</outflow>
				<non_negative/>
			</stock>
			<flow name="WW1">
				<eqn>W1/(delay_duration/4)</eqn>
				<non_negative/>
			</flow>
			<stock name="W3">
				<eqn>0</eqn>
				<inflow>WW2</inflow>
				<outflow>WS</outflow>
				<non_negative/>
			</stock>
			<flow name="WS">
				<eqn>W3/(delay_duration/4)</eqn>
				<non_negative/>
			</flow>
			<aux name="initial exposed">
				<eqn>0</eqn>
			</aux>
		</variables>
